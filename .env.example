# ==============================================================================
# Multi-User RAG API Configuration Template
# Copy this file to .env and replace placeholder with your actual Groq API key:
# cp .env.example .env
# ==============================================================================

# Required: Groq API Key for Llama-3.3-70b-versatile LLM inference
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding Model (HuggingFace Multilingual MPNet)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
TOP_K=3

# Storage Paths
DATA_DIR=./data
INDEX_PATH=./faiss_index.bin
METADATA_PATH=./chunks.json
